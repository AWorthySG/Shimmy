# Supabase — Custom Booking System
# Get these from: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Brow selfie upload (/brows/selfie) — photos go to the artist's Telegram
# 1. Create a bot with @BotFather and copy its token.
# 2. Message the bot once, then open https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
